@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap');

:root {
  /* Brand Palette - Primary — OKLCH */
  --midnight-blue: #0F1B4C;
  --accent-action: oklch(0.68 0.16 85);

  /* Semantic — domain-earned status colors */
  --success: #22C55E;
  --warning: #F59E0B;
  --error: #EF4444;
  --info: #3B82F6;

  /* Core Light Theme — all neutrals tinted toward midnight blue (hue 263) */
  --bg-0: oklch(0.982 0.002 263);
  --bg-1: oklch(0.992 0.001 263);
  --bg-2: oklch(0.955 0.003 263);
  --bg-3: oklch(0.905 0.005 263);
  
  --border-subtle: oklch(0.935 0.003 263);
  --border-default: oklch(0.885 0.005 263);
  --border-strong: oklch(0.80 0.007 263);

  --text-0: oklch(0.15 0.012 263);
  --text-1: oklch(0.35 0.008 263);
  --text-2: oklch(0.58 0.005 263);
  --text-3: oklch(0.74 0.004 263);
  --text-4: oklch(0.50 0.005 263);

  --accent: oklch(0.27 0.11 263);
  --accent-hover: oklch(0.22 0.11 263);
  --accent-fg: oklch(0.985 0 0);
  --accent-subtle: oklch(0.96 0.008 263);
  
  --focus: oklch(0.55 0.16 250);
  --verified: oklch(0.60 0.16 150);
  --verified-bg: oklch(0.95 0.035 150);
  --verified-fg: oklch(0.50 0.14 150);
  --failed: oklch(0.55 0.20 25);
  --failed-bg: oklch(0.95 0.030 25);
  --failed-fg: oklch(0.48 0.18 25);
  --bypass: oklch(0.68 0.14 95);
  --bypass-bg: oklch(0.96 0.04 95);
  --bypass-fg: oklch(0.58 0.10 95);
  
  --accent-secondary: transparent;
  --accent-secondary-border: oklch(0.27 0.11 263);
  --accent-secondary-fg: oklch(0.27 0.11 263);
  --accent-secondary-hover: oklch(0.96 0.008 263);

  /* Font Stacks */
  --font-heading: 'DM Sans', system-ui, sans-serif;
  --font-body: 'IBM Plex Sans', system-ui, sans-serif;

  /* Type Scale — minor third (1:1.2) */
  --text-xs: 0.6875rem;   /* 11px — labels, breadcrumb, metadata */
  --text-sm: 0.8125rem;   /* 13px — secondary body, nav items, stat rows */
  --text-base: 0.875rem;  /* 14px — primary body, table cells, inputs */
  --text-md: 1.0625rem;   /* 17px — section titles, card headings */
  --text-lg: 1.25rem;     /* 20px — page headings, sidebar brand */
  --text-xl: 1.5rem;      /* 24px — hero numbers, login mark */
  --text-2xl: 2rem;       /* 32px — only when earned */

  /* Enterprise / Antigravity Shadows */
  /* Shadows — brand-tinted midnight blue */
  --shadow-sm: 0 4px 6px -1px oklch(0.27 0.08 263 / 0.05), 0 2px 4px -2px oklch(0.27 0.08 263 / 0.05);
  --shadow-md: 0 10px 15px -3px oklch(0.27 0.08 263 / 0.08), 0 4px 6px -4px oklch(0.27 0.08 263 / 0.05);
  --shadow-lg: 0 20px 25px -5px oklch(0.27 0.08 263 / 0.10), 0 8px 10px -6px oklch(0.27 0.08 263 / 0.05);
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg-0: oklch(0.12 0.012 263);
    --bg-1: oklch(0.17 0.010 263);
    --bg-2: oklch(0.22 0.008 263);
    --bg-3: oklch(0.28 0.007 263);
    
    --border-subtle: oklch(0.24 0.006 263);
    --border-default: oklch(0.32 0.005 263);
    --border-strong: oklch(0.42 0.005 263);

    --text-0: oklch(0.96 0.002 263);
    --text-1: oklch(0.88 0.003 263);
    --text-2: oklch(0.60 0.005 263);
    --text-3: oklch(0.45 0.005 263);
    --text-4: oklch(0.45 0.005 263);

    --accent: oklch(0.72 0.12 250);
    --accent-hover: oklch(0.65 0.14 250);
    --accent-fg: oklch(0.12 0.012 263);
    --accent-subtle: oklch(0.28 0.015 263);

    --focus: oklch(0.72 0.12 250);
    --verified: oklch(0.70 0.14 150);
    --verified-bg: oklch(0.25 0.04 150);
    --verified-fg: oklch(0.70 0.14 150);
    --failed: oklch(0.68 0.16 25);
    --failed-bg: oklch(0.25 0.05 25);
    --failed-fg: oklch(0.68 0.16 25);
    --bypass: oklch(0.78 0.12 95);
    --bypass-bg: oklch(0.25 0.04 95);
    --bypass-fg: oklch(0.78 0.12 95);

    --accent-secondary-border: oklch(0.72 0.12 250);
    --accent-secondary-fg: oklch(0.72 0.12 250);
    --accent-secondary-hover: oklch(0.30 0.015 263);

    --shadow-sm: 0 4px 6px -1px oklch(0 0 0 / 0.3);
    --shadow-md: 0 10px 15px -3px oklch(0 0 0 / 0.4);
    --shadow-lg: 0 20px 25px -5px oklch(0 0 0 / 0.5);
  }

  body {
    font-weight: 450;
    letter-spacing: 0.0025em;
  }

  th {
    letter-spacing: 0.8px;
  }
}
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-0);
  color: var(--text-1);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-size: 14px;
  line-height: 1.6;
  font-weight: 400;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: absolute;
  top: -40px;
  left: 0;
  background: var(--accent);
  color: var(--accent-fg);
  padding: 8px 16px;
  z-index: 100;
  font-weight: 600;
  text-decoration: none;
  border-radius: 0 0 8px 0;
  transition: top 0.2s ease;
}

.skip-link:focus {
  top: 0;
}
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 600;
  color: var(--text-0);
  letter-spacing: -0.01em;
}


*:focus-visible {
  outline: 2px solid var(--focus);
  outline-offset: 2px;
  border-radius: 4px;
}

th {
  text-align: left;
  padding: 8px 12px;
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 0.6px;
  border-bottom: 1px solid var(--border-subtle);
}

td {
  padding: 8px 12px;
  font-size: var(--text-sm);
  color: var(--text-1);
  border-bottom: 1px solid var(--bg-1);
  white-space: nowrap;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

tr:hover td {
  background-color: var(--bg-2);
}

input[type="date"]::-webkit-calendar-picker-indicator {
  filter: invert(0.7);
  cursor: pointer;
}

select,
button[aria-haspopup="listbox"] {
  cursor: pointer;
  font-family: var(--font-body);
}

button[aria-haspopup="listbox"]:focus-visible {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent);
}

button {
  cursor: pointer;
  border-radius: 10px;
  font-weight: 600;
  padding: 8px 16px;
  background-color: var(--accent);
  color: var(--accent-fg);
  border: none;
  transition: background-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  font-family: var(--font-body);
}

button:hover:not(:disabled) {
  background-color: var(--accent-hover);
}

button:active:not(:disabled) {
  transform: scale(0.98);
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

.btn-secondary {
  background-color: var(--accent-secondary);
  color: var(--accent-secondary-fg);
  border: 1px solid var(--accent-secondary-border);
}

.btn-secondary:hover:not(:disabled) {
  background-color: var(--accent-secondary-hover);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes fade-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-4px); }
  40% { transform: translateX(4px); }
  60% { transform: translateX(-3px); }
  80% { transform: translateX(2px); }
}

.animate-in {
  animation: fade-in 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.animate-shake {
  animation: shake 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@media (prefers-reduced-motion: reduce) {
  .animate-in,
  .animate-shake {
    animation: none;
  }
}

.spinner {
  display: inline-block;
  width: 16px;
  height: 16px;
  border: 2px solid var(--border-strong);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* App Layout */
.app-layout {
  display: flex;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  background-color: var(--bg-0);
  color: var(--text-1);
}

.sidebar {
  width: 260px;
  background-color: var(--bg-1);
  border-right: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.sidebar-header {
  padding: 32px 24px;
  display: flex;
  align-items: center;
}

.sidebar-title {
  font-size: var(--text-lg);
  font-weight: 700;
  color: var(--text-0);
  letter-spacing: 0.3px;
  text-transform: uppercase;
}

.sidebar-nav {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 0 16px;
}

.nav-item {
  padding: 12px 16px;
  border-radius: 8px;
  color: var(--text-2);
  font-size: var(--text-sm);
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  transition: background-color 0.2s, color 0.2s;
  min-height: 44px;
}

.nav-item:hover {
  background-color: var(--bg-2);
  color: var(--text-1);
}

.nav-item.active {
  background-color: var(--bg-2);
  color: var(--text-0);
  font-weight: 600;
}

.sidebar-footer {
  padding: 24px;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-info {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.user-email {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--text-0);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-role {
  font-size: var(--text-xs);
  color: var(--text-3);
}

.logout-btn {
  background: transparent;
  border: 1px solid var(--border-subtle);
  color: var(--text-3);
  cursor: pointer;
  font-size: 14px;
  padding: 6px 10px;
  border-radius: 6px;
  min-width: 44px;
  min-height: 44px;
}

.logout-btn:hover {
  color: var(--text-0);
  border-color: var(--border-strong);
  background-color: var(--bg-2);
}

.main-content {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.top-bar {
  height: 80px;
  padding: 0 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-subtle);
  flex-shrink: 0;
  background-color: var(--bg-1);
}

.breadcrumb {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--text-3);
  letter-spacing: 0.8px;
  text-transform: uppercase;
}

.breadcrumb-active {
  color: var(--text-0);
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: var(--bg-2);
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  padding: 8px 16px;
  width: 320px;
}

.search-input {
  background: transparent;
  border: none;
  color: var(--text-1);
  font-size: var(--text-sm);
  width: 100%;
  outline: none;
}

.search-input::placeholder {
  color: var(--text-4);
}

.content-body {
  flex-grow: 1;
  overflow-y: auto;
  padding: 32px 40px;
  display: flex;
  gap: 32px;
}

.left-panel {
  width: 340px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.right-panel {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  gap: 24px;
  min-width: 0;
}

.profile-card {
  background-color: var(--bg-1);
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  padding: 24px;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}

.profile-avatar {
  width: 64px;
  height: 64px;
  border-radius: 12px;
  background-color: var(--bg-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-xl);
  color: var(--text-3);
  font-weight: 600;
}

.profile-name {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--text-0);
  margin: 0 0 4px 0;
}

.profile-meta {
  font-size: var(--text-sm);
  color: var(--text-3);
  margin: 0;
}

.profile-rate {
  margin-left: auto;
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--verified);
}

.section-title {
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--text-3);
  margin: 0 0 16px 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  font-size: var(--text-sm);
}

.stat-label {
  color: var(--text-2);
}

.stat-value {
  color: var(--text-0);
  font-weight: 500;
}

.progress-bar-container {
  height: 6px;
  background-color: var(--bg-2);
  border-radius: 3px;
  overflow: hidden;
  margin-top: 8px;
}

.progress-bar-fill {
  height: 100%;
  background-color: var(--accent-action);
  border-radius: 3px;
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.table-container {
  background-color: var(--bg-1);
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  overflow: hidden;
}

.filters-bar {
  display: flex;
  gap: 16px;
  align-items: flex-end;
  flex-wrap: wrap;
  margin-bottom: 24px;
}

.login-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-0);
  padding: 24px;
}

/* Tablet: 1024px */
@media (max-width: 1024px) {
  .content-body {
    flex-direction: column;
  }
  .left-panel {
    width: 100%;
  }
}

/* Small Tablet: 768px */
@media (max-width: 768px) {
  .app-layout {
    flex-direction: column;
  }
  .sidebar {
    width: 100%;
    height: auto;
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    border-right: none;
    border-bottom: 1px solid var(--border-subtle);
  }
  .sidebar-header {
    padding: 16px 0;
  }
  .sidebar-nav {
    flex-direction: row;
    padding: 0;
    margin-left: 20px;
  }
  .sidebar-footer {
    border-top: none;
    padding: 0;
    margin-left: auto;
  }
  
  .pivot-table, .pivot-table tbody, .pivot-table tr, .pivot-table td {
    display: block;
    width: 100%;
  }
  .pivot-table thead {
    display: none;
  }
  .pivot-table tr {
    margin-bottom: 16px;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background-color: var(--bg-1);
    overflow: hidden;
  }
  .pivot-table td {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding: 12px 16px;
    text-align: right;
  }
  .pivot-table td::before {
    content: attr(data-label);
    font-weight: 600;
    color: var(--text-2);
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 0.5px;
  }
}

/* Phone: 480px */
@media (max-width: 480px) {
  .top-bar {
    padding: 0 16px;
  }
  .content-body {
    padding: 16px;
  }
  .stat-row {
    flex-direction: column;
    align-items: flex-start;
  }

}